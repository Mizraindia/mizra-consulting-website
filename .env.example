# Names of the settings the site reads. Real values go in Vercel:
# Project > Settings > Environment Variables. Never commit real values.

# Google Apps Script web app attached to the leads sheet (integrations/google-apps-script/leads.gs)
LEADS_SHEET_URL=
# Long random password; must match SHARED_SECRET in the script's Script Properties
LEADS_SHEET_SECRET=

# Cloudflare Turnstile invisible bot check (optional; forms work without it)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 measurement ID, G-XXXXXXX (optional; analytics and the consent banner are off when empty)
NEXT_PUBLIC_GA_ID=

# Search engine verification codes, HTML-tag method (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
