# Names of the settings the site reads. Real values go in Vercel:
# Project > Settings > Environment Variables. Never commit real values.

# Google Apps Script web app attached to the leads sheet (integrations/google-apps-script/leads.gs)
LEADS_SHEET_URL=
# Long random password; must match SHARED_SECRET in the script's Script Properties
LEADS_SHEET_SECRET=

# Cloudflare Turnstile invisible bot check (optional; forms work without it)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics and search verification (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
